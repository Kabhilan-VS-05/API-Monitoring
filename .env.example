# MongoDB Configuration
# Copy this file to .env and update values before running the app.
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=api_monitoring

# GitHub Integration (Optional - can also be provided via UI)
# Get your token from: https://github.com/settings/tokens
# Required scopes: repo, read:org
GITHUB_TOKEN=your_github_personal_access_token_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False
FLASK_SECRET_KEY=change_this_to_a_long_random_secret

# Network pre-check before API speed checks
NETWORK_TEST_URL=https://www.gstatic.com/generate_204
NETWORK_TEST_URLS=https://www.gstatic.com/generate_204,https://api.github.com
NETWORK_TEST_TIMEOUT_SECONDS=6
# Keep this low/zero for connectivity endpoints like /generate_204
NETWORK_MIN_DOWNLOAD_MBPS=0
NETWORK_MAX_LATENCY_MS=3000

# SLO / Error budget / Burn-rate alerts
SLO_TARGET_UPTIME_PCT=99.9
SLO_ERROR_BUDGET_WINDOW_DAYS=30
BURN_RATE_WARNING_1H=6.0
BURN_RATE_WARNING_6H=3.0
BURN_RATE_CRITICAL_1H=14.4
BURN_RATE_CRITICAL_6H=6.0
BURN_RATE_ALERT_COOLDOWN_MINUTES=30
ALERT_SUPPRESSION_COOLDOWN_MINUTES=30
ALERT_FAILURE_THRESHOLD=1
ALERT_RECOVERY_THRESHOLD=3
FREE_MAX_MONITORS=100

# Authentication + email verification
AUTH_REQUIRED=False
AUTH_REQUIRE_EMAIL_VERIFICATION=True
AUTH_SESSION_DAYS=7
AUTH_EMAIL_TOKEN_MAX_AGE_SECONDS=86400
AUTH_BASE_URL=http://127.0.0.1:5000
AUTH_SMTP_HOST=smtp.gmail.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=your_email@example.com
AUTH_SMTP_APP_PASSWORD=your_app_password_here
AUTH_SMTP_FROM_EMAIL=your_email@example.com
AUTH_EMAIL_SUBJECT=Verify your API Monitoring account

SMS_API_TOKEN=any-dummy-token
# WhatsApp Notification (optional)
WHATSAPP_API_URL=https://api.example.com/whatsapp/send
WHATSAPP_API_TOKEN=your_whatsapp_api_token_here

TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid_here

# IVR / Voice Calls (optional)
IVR_API_URL=https://api.example.com/ivr/call
IVR_API_TOKEN=your_ivr_api_token_here
